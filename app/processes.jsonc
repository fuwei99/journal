// 容器内进程表。supervisor.py 启动时读一次（容器生命周期内不变，无需热加载）。
//
// ⚠️ 端口分配: core=7860（内部）, gateway=8080（唯一对外）。
//    后端二进制在 cloud 模式下强制 bind 7860，压不住，故让 gateway 避让。
{
  "checkInterval": 15,   // 巡检间隔(秒)
  "startStagger": 2,     // 依次启动的间隔(秒)

  "processes": [
    {
      "id": "core",
      "enabled": true,
      "command": "/opt/bin/journal-core --config /data/config.yaml",
      "cwd": "/data",
      // 它自己就要 7860，这里显式给上保持一致（supervisor 也会按 CLIPROXY_PORT 兜一层）
      "env": { "PORT": "7860" },
      "check": { "http": "http://127.0.0.1:7860/management.html" },
      "grace": 25,          // 起来要连 Postgres 拉凭据，给足时间
      "restartDelay": 5
    },
    {
      "id": "wb2",
      "enabled": true,
      // 第二后端: OpenAI 兼容网关，只监听回环，由 gateway 按 /wb2 前缀反代
      "command": "/opt/bin/wb2-core -config /data/wb2/config.json",
      "cwd": "/data/wb2",
      "env": { "PORT": "7863" },
      "check": { "http": "http://127.0.0.1:7863/v1/models" },
      "grace": 20,
      "restartDelay": 5
    },
    {
      "id": "gateway",
      "enabled": true,
      // 唯一对外监听的进程 —— PaaS 的 app_port 必须填 8080
      "command": "python3 /app/gateway.py",
      "cwd": "/app",
      "check": { "http": "http://127.0.0.1:8080/__health" },
      "grace": 10,
      "restartDelay": 3
    }
  ]
}
